      "id": "35451a0c-1ad5-4c02-804b-d19afd282b09",
      "name": "Get last execution timestamp",
      "type": "n8n-nodes-base.code",
      "position": [
        540,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n// Code here will run once per input item.\n\nconst staticData = $getWorkflowStaticData('global');\n\nif (!staticData.lastExecution) {\n  staticData.lastExecution = new Date();\n}\n\nitem.executionTimeStamp = new Date();\nitem.lastExecution = staticData.lastExecution;\n\nreturn { json: item };"
      },
      "typeVersion": 2
    },
    {
      "id": "18ff2308-216e-4c1e-afb9-bd41ae7b5e4d",
